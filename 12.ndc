let init, lines = read_file("input/12").split_once("\n\n");
let _, init = init.split_once(": ");

let rules = %{:"."};
for line in lines.lines() {
  let from, to = line.split_once(" => ");
  rules[from] = to;
}

fn evolve(cur,idx0) {
  idx0 += 1;
  // Pad with ... 
  let cur = "..." ++ cur ++ "...";
  let len = cur.len();
  let new = "";

  for i in 2..(len-2) {
    let slice = cur.slice(i-2,5);
    new.append(rules[slice]);
  }

  let ok = true;
  let trim = 0;
  for c in new {
    if c == "." and ok {
      trim += 1;
    } else {
      ok = false;
    }
  }
  let l = new.len();

  idx0 - trim, new.slice(trim, l - trim)
}

fn score(idx0, cur) {
  let idx = 0 - idx0;
  let ans = 0;
  for c in cur {
    if c == "#" {
      ans += idx;
    }
    idx += 1;
  }
  ans
}

let cur = init;
let idx0 = 0;
print("0", cur);
let i = 0;
let a = [];
let target = 50000000000;
while i < target {
  idx0, cur = evolve(cur, idx0);
  // print(i, idx0, score(idx0, cur), cur);
  a.push(score(idx0, cur));
  i += 1;

  if a.len() >= 2 and a[-1] - a[-2] == 96 {
    let rem = target - i;
    print(score(idx0 - rem, cur));
    break;
  }
}
