lines = read_file("input/2").lines();

let two, three = 0, 0;

for line in lines {
  let has_two, has_three = false, false;
  
  for c in "abcdefghijklmnopqrstuvwxyz" {
    let count = [ 1 for cc in line, if cc == c ].sum();

    if count == 2 { 
      has_two = true;
    } else if count == 3 {
      has_three = true;
    }
  }

  if has_two { 
    two += 1;
  }
  if has_three {
    three += 1;
  }
}

print("Part 1:", two * three);


fn part2() {

  for v in lines, vv in lines {
    let idx = 0;
    let len = v.len();
    let diff = 0;
    while idx < len and diff <= 1 {
      if v[idx] != vv[idx] {
        diff += 1;
      }
      idx += 1;
    }
    
    // if diff is exactly one
    if diff == 1 {
      idx = 0;
      let ans = "";
      while idx < len {
        if v[idx] == vv[idx] {
          ans.append(vv[idx]);
        }
        idx += 1;
      }
      return ans;
    }
  }
}

print("Part 2:", part2());
