let lines = read_file("input/6").lines();

let points = %{};

let min_x, max_x, min_y, max_y = Inf, -Inf, Inf, -Inf;

for x, y in [line.nums() for line in lines] {
  points.insert((x, y));
  min_x min= x;
  min_y min= y;
  max_x max= x;
  max_y max= y;
}

let sizes = %{:0};

let part_two = 0;

for x in min_x..=max_x, y in min_y..=max_y {
  let dists = %{};
  let sum = 0;
  for px, py in points.keys() {
  let dist = abs(px - x) + abs(py - y);
    sum += dist;
    if dist in dists {
      dists[dist].insert((px, py));
    } else {
      dists[dist] = %{(px, py)};
    }

  }

  if sum < 10_000 {
    part_two += 1;
  }

  let m = dists.min()
  if dists[m].len() == 1 {
    for p, _ in dists[m] {
      sizes[p] += 1;
    }
  }
}

let best = 0;

for point, size in sizes {
  best max= size;
}

print("part 1", best);
print("part 2", part_two);
